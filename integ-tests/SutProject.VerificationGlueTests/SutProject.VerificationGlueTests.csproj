<Project Sdk="Microsoft.NET.Sdk">

    <!--
        A VerificationGlue.Tests project. It is a Microsoft.Testing.Platform executable, so the
        scripts run it with `dotnet <dll>` rather than with the VSTest `dotnet test` that the other
        test projects use. See scripts/test-verificationglue.sh.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>False</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\DependencyModules.Runtime\DependencyModules.Runtime.csproj"/>
        <ProjectReference Include="..\..\src\DependencyModules.VerificationGlue\DependencyModules.VerificationGlue.csproj"/>
        <ProjectReference Include="..\SutProject\SutProject.csproj"/>
        <ProjectReference Include="..\..\src\DependencyModules.SourceGenerator\DependencyModules.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="VerificationGlue.Tests" Version="$(VerificationGlueVersion)"/>
    </ItemGroup>

</Project>
