<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <!--
      VerificationGlue.Tests builds against the Microsoft.Testing.Platform 3 previews, which are
      published only on this feed. DependencyModules.VerificationGlue and its test project need it.
    -->
        <add
            key="test-tools"
            value="https://pkgs.dev.azure.com/dnceng/public/_packaging/test-tools/nuget/v3/index.json"
        />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*" />
            <!-- xunit.v3 takes its stable Microsoft.Testing.* versions from nuget.org. -->
            <package pattern="Microsoft.Testing.*" />
        </packageSource>
        <packageSource key="test-tools">
            <package pattern="Microsoft.Testing.*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
