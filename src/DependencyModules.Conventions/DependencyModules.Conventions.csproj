<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <!--
            11 rather than the 10 the sibling generator projects pin, for raw string literals: the
            emitted contract is full of quoted attribute arguments and doubling every one of them in
            a verbatim string is a transcription error waiting to happen. Raw strings are purely
            syntactic and need no runtime support, so this is safe on netstandard2.0.
        -->
        <LangVersion>11</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <Nullable>enable</Nullable>
        <IsPackable>True</IsPackable>
        <PackageId>DependencyModules.Conventions</PackageId>
        <Description>Convention-based registration for DependencyModules. Implement IConventionModule on a module and declare which interfaces to register; the generator resolves the matches at compile time and emits the registrations — no reflection or assembly scanning at run time. Pair with the DependencyModules.SourceGenerator and DependencyModules.Runtime packages.</Description>
        <DevelopmentDependency>true</DevelopmentDependency>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <!-- Analyzer package: ships a single analyzer assembly and no lib/, which is exactly what NU5128 flags. -->
        <NoWarn>$(NoWarn);NU5128</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <PackageCSharpAuthorIncludeSource>true</PackageCSharpAuthorIncludeSource>
    </PropertyGroup>

    <ItemGroup>
        <!-- PackagePath must use a forward slash: a trailing backslash packs to "build//" on Linux/macOS,
             which breaks NuGet's build/$(PackageId).props|targets convention. -->
        <Content Include="Package\DependencyModules.Conventions.*">
            <Pack>true</Pack>
            <PackagePath>build/</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
    </ItemGroup>

    <!-- Roslyn supplies these to the analyzer at load time; they must not flow to consumers. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Primitives" Version="8.0.0" PrivateAssets="all"/>
        <PackageReference Include="System.Memory" Version="4.5.5" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.10.0" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="CSharpAuthor" Version="1.1.1007">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>build</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
    </ItemGroup>

    <!--
        The same shared sources DependencyModules.SourceGenerator compiles in. Impl declares no
        [Generator] of its own, so compiling it into a second analyzer assembly adds no second
        registration of the service, decorator or interceptor generators.
    -->
    <ItemGroup>
        <Compile Include="../DependencyModules.SourceGenerator.Impl/**/*.cs" Exclude="../DependencyModules.SourceGenerator.Impl/obj/**/*">
            <Link>Impl\%(RecursiveDir)/%(FileName)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Compile>
    </ItemGroup>

    <!--
        Release tracking for the DM#### diagnostics (RS2008). Impl carries the descriptors, so this
        assembly declares the same set the main generator does and needs the same tracking files.
    -->
    <ItemGroup>
        <AdditionalFiles Include="../DependencyModules.SourceGenerator.Impl/AnalyzerReleases.Shipped.md"/>
        <AdditionalFiles Include="../DependencyModules.SourceGenerator.Impl/AnalyzerReleases.Unshipped.md"/>
    </ItemGroup>
</Project>
