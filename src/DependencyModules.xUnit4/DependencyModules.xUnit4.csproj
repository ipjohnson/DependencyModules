<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>True</IsPackable>
        <PackageId>DependencyModules.xUnit4</PackageId>
        <DefineConstants>$(DefineConstants);XUNIT_V4</DefineConstants>
        <Description>xUnit v3 support for DependencyModules, for xunit.v3 version 4. [ModuleTest] builds a service provider from your modules for each test and each data row. The test parameters get their values from this service provider. For xunit.v3 version 3, use DependencyModules.xUnit.</Description>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!--
      The sources of DependencyModules.xUnit, compiled against xunit.v3 4.x. One build cannot serve
      both majors, because 4.0 changed ISelfExecutingXunitTestCase.Run and a ModuleTestCase built
      for one major does not load on the other. Impl/ModuleTestCase.XunitMajor.cs holds the code
      that differs, under XUNIT_V4.
    -->
    <ItemGroup>
        <Compile Include="..\DependencyModules.xUnit\**\*.cs"
                 Exclude="..\DependencyModules.xUnit\bin\**;..\DependencyModules.xUnit\obj\**"
                 Link="%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <!-- Framework-matched per TFM; see DependencyModules.Runtime.csproj for why. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <!--
          The extensibility surface only, for the reason DependencyModules.xUnit.csproj gives.
          Compiled against the lowest 4.x and capped below 5.0, for the reason given there too.
        -->
        <PackageReference Include="xunit.v3.extensibility.core" Version="[4.0.0,5.0.0)"/>

        <!-- The analyzers that xunit.v3 4.0.1 brings; see DependencyModules.xUnit.csproj. -->
        <PackageReference Include="xunit.analyzers" Version="2.1.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DependencyModules.Runtime\DependencyModules.Runtime.csproj"/>
        <ProjectReference Include="..\DependencyModules.Testing\DependencyModules.Testing.csproj"/>
    </ItemGroup>

</Project>
