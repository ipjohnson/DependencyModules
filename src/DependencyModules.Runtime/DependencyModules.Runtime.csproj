<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>True</IsPackable>
        <PackageId>DependencyModules.Runtime</PackageId>
        <Description>Runtime support for DependencyModules: attributes, module interfaces, and IServiceCollection extensions used to compose attribute-driven dependency injection modules. Pair with the DependencyModules.SourceGenerator package, which generates the registration code.</Description>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!--
            The runtime does no reflection, and this is what enforces it rather than review. Every
            IL* warning is an error here: each one is a call the trimmer or the AOT compiler cannot
            follow, and every one of them shipped once already as a decorator that resolved under a
            JIT and threw in a published application.
        -->
        <IsAotCompatible>true</IsAotCompatible>
        <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2055;IL2067;IL2072;IL2075;IL2087;IL3050</WarningsAsErrors>
    </PropertyGroup>

    <!--
        Framework-matched rather than one 8.0.0 reference serving both. On net10.0 these
        abstractions are part of the ASP.NET Core shared framework, and pinning the 8.0.0 package
        there puts an older assembly in the consumer's output in place of the one the framework
        already supplies. Each TFM takes its own framework's baseline version, so a consumer rolls
        forward from it rather than being dragged back to it.
    -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0"/>
    </ItemGroup>

</Project>
