<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>10</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsPackable>True</IsPackable>
        <Nullable>enable</Nullable>
        <PackageId>DependencyModules.SourceGenerator.Impl</PackageId>
        <Description>The source code of the DependencyModules generator, for the source generator of a framework. Set PackageDependencyModuleIncludeSource to true to compile the source code into your generator. The package also contains the source code of CSharpAuthor, which the generator source code uses. For usual projects, use DependencyModules.SourceGenerator.</Description>
        <DevelopmentDependency>true</DevelopmentDependency>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <!-- Source-only package: ships .cs under src/ and no lib/, which is exactly what NU5128 flags. -->
        <NoWarn>$(NoWarn);NU5128</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <PackageCSharpAuthorIncludeSource>true</PackageCSharpAuthorIncludeSource>
    </PropertyGroup>

    <ItemGroup>
        <!-- PackagePath must use a forward slash: a trailing backslash packs to "build//" on Linux/macOS,
             which breaks NuGet's build/$(PackageId).props|targets convention. -->
        <None Remove="Package\DependencyModules.*"/>
        <Content Include="Package\DependencyModules.*">
            <Pack>true</Pack>
            <PackagePath>build/</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
        <Content Include="**\*.cs" Exclude="**\obj\**;**\bin\**" Visible="true">
            <Pack>true</Pack>
            <PackagePath>src/DependencyModules.SourceGenerator.Impl/</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
        <Content Include="..\DependencyModules.SourceGenerator\ServiceSourceGenerator.cs" Visible="true">
            <Pack>true</Pack>
            <PackagePath>src/DependencyModules.SourceGenerator/</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
        <!--
            Convention registration and decoration, so a framework building on this seam gets them
            against its own module attribute rather than only against [DependencyModule].
            ConventionGenerator is the single emission stage: it owns convention registrations and
            every decoration, because a generic decorator has to be closed over the type arguments
            each registration used and both halves of that live here.

            Packed as a tree rather than file by file — it depends on its own Models and Utilities,
            and shipping the entry point without them compiles nowhere.
        -->
        <Content Include="..\DependencyModules.SourceGenerator\Conventions\**\*.cs" Visible="true">
            <Pack>true</Pack>
            <PackagePath>src/DependencyModules.SourceGenerator/Conventions/</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
    </ItemGroup>

    <!-- These deps intentionally flow: consumers compile the shipped sources into their own generator. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Primitives" Version="8.0.0"/>
        <PackageReference Include="System.Memory" Version="4.5.5"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.10.0"/>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="CSharpAuthor" Version="2.0.0" GeneratePathProperty="true">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>build</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!--
        The shipped sources use CSharpAuthor, so its sources ship beside them. A package dependency
        cannot do this: NuGet imports build/ targets only for a direct reference, and CSharpAuthor has
        no buildTransitive/.
    -->
    <ItemGroup>
        <Content Include="$(PkgCSharpAuthor)/src/**/*.cs" Visible="false">
            <Pack>true</Pack>
            <PackagePath>srcCSharpAuthor/</PackagePath>
        </Content>
    </ItemGroup>

    <!-- Release tracking for the DM#### diagnostics (RS2008). -->
    <ItemGroup>
        <AdditionalFiles Include="AnalyzerReleases.Shipped.md"/>
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md"/>
    </ItemGroup>
</Project>
