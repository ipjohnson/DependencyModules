<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>True</IsPackable>
        <PackageId>DependencyModules.xUnit</PackageId>
        <Description>xUnit v3 support for DependencyModules, for xunit.v3 version 3. [ModuleTest] builds a service provider from your modules for each test and each data row. The test parameters get their values from this service provider. For xunit.v3 version 4, use DependencyModules.xUnit4.</Description>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- Framework-matched per TFM; see DependencyModules.Runtime.csproj for why. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <!--
          The extensibility surface only. xunit.v3 pulls in xunit.v3.core.mtp-v1, whose targets
          hard-error unless the project is an executable test project. This project ships
          [ModuleTest] for other people's test projects and is not one. That error names this
          package as the supported answer, which replaces the previous ExcludeAssets workaround.

          Upper-bounded because a build for one xunit.v3 major does not load on the next. A bare
          Version="3.2.2" packs as [3.2.2, ), and a test project on 4.x unified this reference up
          to 4.x. Every [ModuleTest] then failed at discovery: 4.0 removed the GetTestCaseDetails
          overload that the discoverer binds to, and changed ISelfExecutingXunitTestCase.Run, so
          ModuleTestCase does not load. Nothing warned at restore or build, and the error named an
          xUnit member rather than this package. With the range, restore reports NU1608 and names
          this package.

          DependencyModules.xUnit4 compiles these sources against 4.x. The code that differs
          between the majors is in Impl/ModuleTestCase.XunitMajor.cs.
        -->
        <PackageReference Include="xunit.v3.extensibility.core" Version="[3.2.2,4.0.0)"/>

        <!--
          Referenced explicitly because xunit.v3.extensibility.core does not carry it the way
          xunit.v3 did. Dropping to the extensibility package would otherwise take the xUnit
          analyzers with it silently — the rules stop being checked rather than being satisfied.
        -->
        <PackageReference Include="xunit.analyzers" Version="1.27.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DependencyModules.Runtime\DependencyModules.Runtime.csproj"/>
        <ProjectReference Include="..\DependencyModules.Testing\DependencyModules.Testing.csproj"/>
    </ItemGroup>

</Project>
