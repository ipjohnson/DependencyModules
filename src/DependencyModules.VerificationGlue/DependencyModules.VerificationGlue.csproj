<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- VerificationGlue.Tests ships for net10.0 only. -->
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>True</IsPackable>
        <PackageId>DependencyModules.VerificationGlue</PackageId>
        <Description>VerificationGlue.Tests support for DependencyModules. [ModuleTest] and [ModuleTest&lt;TModule&gt;] build a test container from your modules. The [VerifyTest] parameters get their values from this container, and [Mock] parameters replace the matching services. The test project also references VerificationGlue.Tests.</Description>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!--
            NU5104: a stable version of this package depends on a VerificationGlue.Tests preview.
            VerificationGlue.Tests has no stable version yet, and this package cannot exist without it.
        -->
        <NoWarn>$(NoWarn);NU5104</NoWarn>
        <!--
            The public API snapshot in tests/DependencyModules.Tests reads this assembly from bin/
            without a reference to it, and resolves its base types from the same folder.
        -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <!--
          Upper-bounded below the next minor version, because VerificationGlue.Tests is at 0.x and a
          minor version is where its extension points can change. 0.4.0-0 is the lowest version of
          0.4.0, so the previews of 0.4.0 are outside the range too.

          ExcludeAssets: the build/ props of VerificationGlue.Tests make the project that references
          it an executable test application, and its analyzers write a test registry. This project is
          a library for test projects and is not one. The test project references VerificationGlue.Tests
          itself, as the VerificationGlue documentation says.
        -->
        <PackageReference Include="VerificationGlue.Tests" Version="[$(VerificationGlueVersion),0.4.0-0)" ExcludeAssets="build;buildTransitive;analyzers"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DependencyModules.Runtime\DependencyModules.Runtime.csproj"/>
        <ProjectReference Include="..\DependencyModules.Testing\DependencyModules.Testing.csproj"/>
    </ItemGroup>

</Project>
