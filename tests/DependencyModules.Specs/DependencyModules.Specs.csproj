<Project Sdk="Microsoft.NET.Sdk">

    <!--
        A VerificationGlue.Tests project. It is a Microsoft.Testing.Platform executable, so the
        scripts run it with `dotnet exec` rather than with the VSTest `dotnet test` that the other
        test projects use. See scripts/test-verificationglue.sh. VerificationGlue.Tests targets
        net10.0 only.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>False</IsPackable>
        <!-- A failed Verify lists the value of each part of its condition. -->
        <VerificationGlueRewrite>true</VerificationGlueRewrite>
    </PropertyGroup>

    <!-- The public API snapshot of the xUnit package differs between the two majors. -->
    <PropertyGroup Condition="'$(XunitMajor)' == '4'">
        <DefineConstants>$(DefineConstants);XUNIT_V4</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\DependencyModules.Runtime\DependencyModules.Runtime.csproj"/>
        <!-- Referenced as a library, not an analyzer: these tests drive the generator directly. -->
        <ProjectReference Include="..\..\src\DependencyModules.SourceGenerator\DependencyModules.SourceGenerator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="true"/>
        <ProjectReference Include="..\..\src\DependencyModules.CodeFixes\DependencyModules.CodeFixes.csproj"/>
        <!--
          Referenced for the public API snapshots only. DependencyModules.xUnit references
          xunit.v3.extensibility.core and not xunit.v3, so it brings no Microsoft.Testing.Platform
          version of its own into this project.
        -->
        <ProjectReference Include="..\..\src\$(DependencyModulesXunitProject)\$(DependencyModulesXunitProject).csproj"/>
        <ProjectReference Include="..\..\src\DependencyModules.NUnit\DependencyModules.NUnit.csproj"/>
        <ProjectReference Include="..\..\src\DependencyModules.NSubstitute\DependencyModules.NSubstitute.csproj"/>
        <ProjectReference Include="..\..\src\DependencyModules.Moq\DependencyModules.Moq.csproj"/>
        <ProjectReference Include="..\..\src\DependencyModules.FakeItEasy\DependencyModules.FakeItEasy.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="VerificationGlue.Tests" Version="$(VerificationGlueVersion)"/>
        <PackageReference Include="PublicApiGenerator" Version="11.5.4"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.10.0"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.10.0"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="VerificationGlue"/>
        <Using Include="VerificationGlue.Tests"/>
        <Using Include="VerificationGlue.VerifySyntax" Static="true"/>
    </ItemGroup>

    <!--
        Snapshots are read from the build output so the tests do not depend on source paths,
        which deterministic builds rewrite to /_/... The source location is injected separately
        and used only when UPDATE_SNAPSHOTS=1.
    -->
    <ItemGroup>
        <Content Include="Snapshots\**\*.verified.txt" CopyToOutputDirectory="PreserveNewest" LinkBase="Snapshots"/>
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>SnapshotDirectory</_Parameter1>
            <_Parameter2>$(MSBuildProjectDirectory)/Snapshots</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
