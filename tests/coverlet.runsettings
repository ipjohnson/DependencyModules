<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
    <DataCollectionRunSettings>
        <DataCollectors>
            <DataCollector friendlyName="XPlat code coverage">
                <Configuration>
                    <Format>cobertura</Format>

                    <!--
                        CSharpAuthor is a third-party code-writing library whose sources are
                        compiled into the generator assembly. It is not this project's code and
                        would otherwise dominate the numbers.
                    -->
                    <Exclude>[*]CSharpAuthor.*</Exclude>

                    <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute,ObsoleteAttribute</ExcludeByAttribute>

                    <!-- Trivial get/set bodies are noise, not tested behaviour. -->
                    <SkipAutoProps>true</SkipAutoProps>

                    <DeterministicReport>false</DeterministicReport>
                </Configuration>
            </DataCollector>
        </DataCollectors>
    </DataCollectionRunSettings>
</RunSettings>
