<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>False</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\DependencyModules.Runtime\DependencyModules.Runtime.csproj"/>
        <!-- Referenced as a library, not an analyzer: these tests drive the generator directly. -->
        <ProjectReference Include="..\..\src\DependencyModules.SourceGenerator\DependencyModules.SourceGenerator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="true"/>
        <ProjectReference Include="..\..\src\DependencyModules.xUnit\DependencyModules.xUnit.csproj"/>
        <!--
          Referenced for the public API snapshot only. This project's own tests run on xUnit; the
          NUnit integration is exercised end to end by integ-tests/SutProject.NUnitTests.
        -->
        <ProjectReference Include="..\..\src\DependencyModules.NUnit\DependencyModules.NUnit.csproj"/>
        <ProjectReference Include="..\..\src\DependencyModules.NSubstitute\DependencyModules.NSubstitute.csproj"/>
        <ProjectReference Include="..\..\src\DependencyModules.Moq\DependencyModules.Moq.csproj"/>
        <ProjectReference Include="..\..\src\DependencyModules.FakeItEasy\DependencyModules.FakeItEasy.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.2">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="PublicApiGenerator" Version="11.5.4"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.10.0"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3" Version="3.2.2"/>
    </ItemGroup>

    <!--
        Must track what DependencyModules.xUnit resolves for the same TFM. Left at a flat 8.0.1 it
        is a downgrade against the net10.0 leg, which NU1605 treats as an error.
    -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0"/>
    </ItemGroup>

    <!--
        Snapshots are read from the build output so the tests do not depend on source paths,
        which deterministic builds rewrite to /_/... The source location is injected separately
        and used only when UPDATE_SNAPSHOTS=1.
    -->
    <ItemGroup>
        <Content Include="Snapshots\**\*.verified.txt" CopyToOutputDirectory="PreserveNewest" LinkBase="Snapshots"/>
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>SnapshotDirectory</_Parameter1>
            <_Parameter2>$(MSBuildProjectDirectory)/Snapshots</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
